language ESSENCE' 1.0

letting dataset_ExplicitBoundedR6_Length be 11
letting dataset_ExplicitBoundedR6_Values_1_ExplicitVarSizeWithDummy be
        [[1, 2, 3, 4; int(1..4)], [1, 2, 3, 5; int(1..4)], [1, 2, 4, 5; int(1..4)], [1, 3, 4, 5; int(1..4)],
         [2, 3, 4, 5; int(1..4)], [1, 2, 5, 5; int(1..4)], [1, 3, 5, 5; int(1..4)], [1, 4, 5, 5; int(1..4)],
         [2, 3, 5, 5; int(1..4)], [2, 4, 5, 5; int(1..4)], [3, 4, 5, 5; int(1..4)];
             int(1..11)]

letting dataset_ExplicitBoundedR6_Values_2 be [4, 1, 4, 4, 4, 1, 3, 4, 2, 4, 4; int(1..11)]
letting fin1 be 11
letting fin2 be 4
letting fin3 be 1
letting fin4 be 4
letting fin5 be 1
letting fin6 be 4
letting n be 4 
letting nbObservations be 11
find score: int(0..nbObservations)
find rel_RelationAsMatrix: matrix indexed by [int(1..n), int(1..n)] of int(0..1)
such that
    nbObservations - score =
    sum q8: int (1..fin1) .
    toInt(and([rel_RelationAsMatrix
                        [dataset_ExplicitBoundedR6_Values_2[q8],
                         dataset_ExplicitBoundedR6_Values_1_ExplicitVarSizeWithDummy[q8, q9]] = 1
                        | q9 : int(1..fin2),
                          dataset_ExplicitBoundedR6_Values_1_ExplicitVarSizeWithDummy[q8, q9] != fin4 + 1])),

   and([(rel_RelationAsMatrix[q2, q3] + rel_RelationAsMatrix[q3, q2]) >= 1| q2 : int(1..n), q3 : int(1..n)]),
   and([rel_RelationAsMatrix[q2, q2] = 1 | q2 : int(1..n)]),
   and([(rel_RelationAsMatrix[q2, q3] + rel_RelationAsMatrix[q3, q2]) = 2 -> q2 = q3 | q2 : int(1..n), q3 : int(1..n)]),
   and([rel_RelationAsMatrix[q2, q3] /\ rel_RelationAsMatrix[q3, q4] -> rel_RelationAsMatrix[q2, q4]
            | q2 : int(1..n), q3 : int(1..n), q4 : int(1..n)])

