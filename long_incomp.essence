find a: int(1..4)
find b: int(1..4)
find c: int(1..4)
find d: int(1..4)

dominanceRelation (
    (a+b+c+d) >= (fromSolution(a)+fromSolution(b)+fromSolution(c)+fromSolution(d)) /\
    (a != fromSolution(a) \/ b != fromSolution(b) \/ c != fromSolution(c) \/ d != fromSolution(d))
)

incomparabilityFunction (
    descending (a+b+c+d)
)