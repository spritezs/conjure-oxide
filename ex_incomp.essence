find cost: int(1..15)
find carbon: int(1..15)
such that cost + carbon <= 15
such that (cost + carbon) % 3 = 0

dominanceRelation (
    (cost+carbon) >= (fromSolution(cost)+fromSolution(carbon)) /\
    (cost != fromSolution(cost) \/ carbon != fromSolution(carbon))
)

incomparabilityFunction (
    ascending (cost+carbon)
)