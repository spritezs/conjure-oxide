find cost: int(1..15)
find quality: int(1..15)
such that cost + quality <= 15
such that (cost + quality) % 3 = 0

dominanceRelation (
    (cost+quality) >= (fromSolution(cost)+fromSolution(quality)) /\
    (cost != fromSolution(cost) \/ quality != fromSolution(quality))
)

incomparabilityFunction (
    ascending (cost+quality)
)